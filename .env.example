# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามเครื่อง — ห้าม commit .env จริง (อยู่ใน .gitignore แล้ว)

# ---- Postgres (docker-compose.dev.yml) ----
POSTGRES_USER=lotus
POSTGRES_PASSWORD=lotus
POSTGRES_DB=lotus_desk
POSTGRES_PORT=5432

# ต้องตรงกับค่า POSTGRES_* ด้านบน — apps/api อ่านตัวแปรนี้ตัวเดียว
DATABASE_URL=postgresql://lotus:lotus@localhost:5432/lotus_desk

# ---- Redis (docker-compose.dev.yml) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Mailpit — ดักอีเมลตอนพัฒนา ดูได้ที่ http://localhost:8025 ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- apps/api ----
NODE_ENV=development
PORT=3001

# ---- Auth (T1.2) ----
# ค่านี้ใช้ได้เฉพาะตอนพัฒนาเท่านั้น — สร้างใหม่ก่อนขึ้น production ด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=21ea6ba8fabc9ca3da24318853c717343fecb0b6ae6d7c3019c6cedae5b9c1df
JWT_REFRESH_SECRET=d8cc8b85501cb8f8c8956133a4ce623cc69caa8cfce42797ad81ae33d62f6e96
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
